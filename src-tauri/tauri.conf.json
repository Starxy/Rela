{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rela",
  "version": "0.1.0",
  "identifier": "com.teamsillybees.rela",
  "build": {
    "beforeDevCommand": "npm run prepare:core && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:core && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Rela",
        "width": 400,
        "height": 560,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "binaries/easytier/easytier-core.exe": "easytier/easytier-core.exe",
      "binaries/easytier/easytier-cli.exe": "easytier/easytier-cli.exe",
      "binaries/easytier/wintun.dll": "easytier/wintun.dll",
      "binaries/easytier/Packet.dll": "easytier/Packet.dll",
      "binaries/easytier/WinDivert64.sys": "easytier/WinDivert64.sys",
      "binaries/easytier/manifest.json": "easytier/manifest.json",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../packaging/portable/Remove-Network-Service.cmd": "Remove-Network-Service.cmd",
      "../packaging/portable/Remove-Network-Service.ps1": "Remove-Network-Service.ps1",
      "../third-party-licenses/EasyTier-LGPL-3.0.txt": "third-party-licenses/EasyTier-LGPL-3.0.txt",
      "../third-party-licenses/GPL-3.0.txt": "third-party-licenses/GPL-3.0.txt",
      "../third-party-licenses/WinDivert-LICENSE.txt": "third-party-licenses/WinDivert-LICENSE.txt",
      "../third-party-licenses/Wintun-LICENSE.txt": "third-party-licenses/Wintun-LICENSE.txt"
    },
    "shortDescription": "实验室远程资源入口",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer/hooks.nsh",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDMDE2NjFENTFFRkI5OTMKUldTVHVlOVJIV1lCREora00rUlViTjJjalFLeVdDbmRpMTh6aUY4dU81NUZWakx1cEJHM0dGNUMK",
      "endpoints": [],
      "requireSignedVersion": true,
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
